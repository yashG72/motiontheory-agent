# Copy this file to .env and fill it in.

# --- AI provider: gemini (free tier) or claude (paid) ---
LLM_PROVIDER=gemini

# --- Gemini (free key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Any free-tier model from AI Studio works, e.g. gemini-3.8-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# --- Claude (only if LLM_PROVIDER=claude; key at https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# --- Behaviour ---
BUSINESS_NAME=MotionTheory
# draft = save replies for you to approve (start here); auto = send immediately
REPLY_MODE=draft
# Calendly / Cal.com / Google Calendar booking page for discovery calls
BOOKING_LINK=
# Secret for the admin endpoints (/leads, /drafts). Pick a long random string.
ADMIN_TOKEN=change-me
# Where "lead needs a human" alerts go
ALERT_EMAIL=

# --- Instagram (Meta developer app with "Instagram API with Instagram Login") ---
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_APP_SECRET=
IG_VERIFY_TOKEN=motiontheory-verify
IG_GRAPH_VERSION=v23.0

# --- Email (Gmail shown; for Outlook use outlook.office365.com / smtp.office365.com) ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_POLL_SECONDS=60
